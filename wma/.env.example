# Copy to a private .env file and fill in unique credentials before deployment.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=wma
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
REDIS_URL=redis://127.0.0.1:6379/1
MEDIA_URL=/media/
WRITE_LOG_ON_FILE=false
WRITE_LOG_ON_CONSOLE=true

# Docker: choose mysql or sqlite3; for mysql set DB_NAME=wma and both passwords.
PROJECT_NAME=watermanagement
DEPLOY_ENV=production
VPS_STORAGE_ROOT=/srv/apps
APP_PORT=8005
HOST_BIND=127.0.0.1
MYSQL_ROOT_PASSWORD=
WEB_WORKERS=1
WEB_TIMEOUT=120
WEB_MEMORY_LIMIT=1g
MYSQL_MEMORY_LIMIT=1g
MYSQL_BUFFER_POOL_SIZE=64M
MYSQL_MAX_CONNECTIONS=30
CSRF_TRUSTED_ORIGINS=https://wmapp.in,https://www.wmapp.in
